# Copy thành .env và điền giống DBeaver (database: xevn_xbos)
# Hoặc chạy scripts/seed-org-foundation-dbeaver.sql trực tiếp trong DBeaver — không cần file này.

PORT=3002

# Cách 1 — connection string (ưu tiên)
# DATABASE_URL_XBOS=postgresql://USER:PASSWORD@HOST:PORT/xevn_xbos

# Cách 2 — từng trường (giống deploy/xevn-ecosystem/.env). DB_NAME mặc định xevn_xbos.
# Bắt buộc tối thiểu DB_HOST + DB_PORT + DB_USER (DB_PASSWORD có thể rỗng nếu postgres cho phép).
# DB_NAME_XBOS=xevn_xbos
# DB_HOST=113.20.107.184
# DB_PORT=6432
# DB_USER=app1
# DB_PASSWORD=<mật khẩu DBeaver của bạn>

MASTER_TENANT_ID=xevn
DEFAULT_COMPANY_ID=holding

INTERNAL_API_KEY=xevn-dev-internal-key

# Command Center P0 — legal document files (dev: repo folder; prod: server path)
# XBOS_LEGAL_DOC_STORAGE_ROOT=/var/xevn/uploads/legal-documents
# XBOS_PUBLIC_BASE_URL=http://127.0.0.1:28002
# XBOS_LEGAL_DOC_MAX_BYTES=26214400
# XBOS_CC_DATA_SYNC_NOTE=
SERVICE_JWT_SECRET=replace_with_strong_secret
SERVICE_JWT_ISSUER=xevn-internal
SERVICE_JWT_AUDIENCE=xevn-api
