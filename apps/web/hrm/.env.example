# Pilot / production: Nest HRM API only — no Supabase REST on user-facing paths.
VITE_HRM_USE_API=true

# Tenant scope when reading settings-catalogs (khớp Command Center / seed xe-du-lich)
VITE_HRM_SCOPE_TENANT_ID=xe-du-lich

# Tenant-only list scope — khớp hrm-api HRM_TENANT_ONLY_SCOPE (standalone :8080 hoặc portal embed)
VITE_HRM_TENANT_ONLY_SCOPE=true

# Nest HRM API (để trống = same-origin /api/hrm qua portal proxy).
# VITE_HRM_API_ORIGIN=

# Vite dev proxy target for /api/hrm (standalone :8080). Local default = :3001.
# VITE_DEV_PROXY_HRM_API=http://127.0.0.1:3001

# Portal login redirect when opening HRM standalone (:8080) — use web-portal dev URL
# VITE_PORTAL_PUBLIC_ORIGIN=http://127.0.0.1:5175

# Legacy standalone Supabase (Wave 2+) — only when VITE_HRM_USE_API=false
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=
