# Copy to apps/web/web-portal/.env (local dev). Cần để gọi XBOS khi chưa đăng nhập JWT.
# Trùng INTERNAL_API_KEY / default user với apps/api/xbos-api khi NODE_ENV=development.
#
# Lỗi đỏ "500 Internal Server Error" khi tải đơn vị thành viên = thường do:
# (1) chưa chạy xbos-api, hoặc (2) proxy sai cổng (mặc định 28002, không phải 3002).
# Chạy: `pnpm dev` (portal + xbos-api) hoặc `pnpm dev:xbos-api` rồi `pnpm dev:web-only`.

# Tenant mặc định cho filter + org-foundation (Du lịch XeVN)
VITE_DEFAULT_TENANT_ID=xe-du-lich

VITE_INTERNAL_API_KEY=xevn-dev-internal-key
VITE_DEV_USER_ID=admin@xevn.vn
VITE_DEV_PROXY_XBOS_API=http://127.0.0.1:28002

# BR-MOCK-02: chỉ khi true + import.meta.env.DEV mới được fallback mock trên lỗi API
VITE_ALLOW_MOCK_FALLBACK=false

# Seed stack (từ repo root, sau khi DB + migrate):
# pnpm seed:stack:p0 → pnpm dev:xbos-api & pnpm dev:hrm-api → pnpm seed:workflow:inbox
# → pnpm seed:business-master:kpi → pnpm seed:business-master:settings-md → pnpm seed:hrm:operations-sample
# Verify: pnpm verify:dev-stack
