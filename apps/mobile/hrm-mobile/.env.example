# Copy to `.env` for Expo. Chỉ cấu hình URL API — tenant/công ty do server trả sau login.
# Local (hrm-api host — deploy pick-ports / VITE_DEV_PROXY_HRM_API mặc định 28001)
EXPO_PUBLIC_HRM_API_BASE_URL=http://127.0.0.1:28001
# Android emulator → host hrm-api (MOB-04 / qa-device): Cài đặt dev URL hoặc bundle env:
#   EXPO_PUBLIC_HRM_API_BASE_URL=http://10.0.2.2:28001
#   (adb reverse tcp:28001 tcp:28001 hoặc host log proxy 17801→28001 — không đổi pilot release default)
# VPS/dev — deploy/xevn-ecosystem/.env.example HRM_BE_PORT=3001 (API trực tiếp; không dùng PORTAL :8088)
# EXPO_PUBLIC_HRM_API_BASE_URL=http://14.225.217.232:3001
# Push registration (HRM-NT-02): off for sponsor release APK; qa-device build sets 1 automatically.
# EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=0
# Manual override before bundle: EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=1
# qa-device APK: pnpm run android:apk:qa-device (embeds PUSH_REG=1 + QA_PUSH_FALLBACK=1 unless env overrides)
# Real FCM (Option A): place Firebase Android config (never commit):
#   copy android/app/google-services.json.example → android/app/google-services.json (fill real values)
#   or: set GOOGLE_SERVICES_JSON=C:\secrets\xevn-hrm-google-services.json before android:apk:qa-device
# EXPO_PUBLIC_QA_PUSH_TOKEN_FALLBACK=0
# (qa-device default 1 = Expo-format register when FirebaseApp missing; release stays 0)

