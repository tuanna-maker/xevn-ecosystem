# Copy to `.env` for Expo. Chỉ cấu hình URL API — tenant/công ty do server trả sau login.
# Local (hrm-api host — deploy pick-ports / VITE_DEV_PROXY_HRM_API mặc định 28001)
EXPO_PUBLIC_HRM_API_BASE_URL=http://127.0.0.1:28001
# VPS/dev — deploy/xevn-ecosystem/.env.example HRM_BE_PORT=3001 (API trực tiếp; không dùng PORTAL :8088)
# EXPO_PUBLIC_HRM_API_BASE_URL=http://14.225.217.232:3001
# Set to 1 only after google-services.json / FCM credentials are in the Android app.
# EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=0
