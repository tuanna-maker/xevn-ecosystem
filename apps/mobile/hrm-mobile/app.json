{
  "expo": {
    "name": "XeVN HRM",
    "slug": "xevn-hrm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.xevn.hrm.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "vn.xevn.hrm.mobile"
    },
    "scheme": "xevn",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f172a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền thư viện ảnh để cập nhật ảnh đại diện."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để ghi nhận vị trí thiết bị khi chấm công."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "36a4e288-7b45-4019-abaa-d2460c21c5b7"
      }
    },
    "owner": "tuanna-unicom"
  }
}
