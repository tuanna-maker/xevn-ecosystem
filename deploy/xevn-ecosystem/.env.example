# Stack dev / POC (demo khách): dùng **một** mật khẩu Postgres cho user `DB_USER` — không cần secret production tách riêng.
# `XEVN_POC_DEV=1`: script migrate không chặn giá trị mẫu `replace_me` (vẫn phải trùng mật khẩu thực tế trên DB nếu không phải replace_me).
# Hoặc đặt biến máy: XEVN_DB_PASSWORD (PowerShell: $env:XEVN_DB_PASSWORD='...') — không commit.
XEVN_POC_DEV=1

# --- Supabase (gom chung cho API + web; project ref từ apps/web/hrm/supabase/config.toml) ---
SUPABASE_PROJECT_REF=hbwyuqsjiywtvvellfmn

# Mặc định: Supabase CLI local (`supabase start`) — URL + JWT demo chính thức (anon giống apps/web/hrm/src/integrations/supabase/client.ts).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Khi dùng Supabase Cloud: comment 3 dòng trên, bật 3 dòng dưới và điền anon + service_role từ Dashboard (Settings → API).
# SUPABASE_URL=https://hbwyuqsjiywtvvellfmn.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Web HRM (Vite) — copy sang apps/web/hrm/.env.local hoặc để trùng khi dev local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Dev PostgreSQL (cùng cluster; mỗi phân hệ một database logic).
# Tên DB cố định trong script migrate: HRM → xevn_hrm, XBOS → xevn_xbos (xem migrations/README.md).
DB_HOST=113.20.107.184
DB_PORT=6432
DB_USER=app1
# Postgres dev/POC — đặt trùng mật khẩu user trên server dev (một credential dùng chung).
# Nếu DB của bạn đúng literal "replace_me" và đã bật XEVN_POC_DEV=1, migrate sẽ không chặn trước khi kết nối.
DB_PASSWORD=replace_me

# Optional. Leave empty to use DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
DATABASE_URL_HRM=
DATABASE_URL_XBOS=

INTERNAL_API_KEY=xevn-dev-internal-key
MASTER_TENANT_ID=xevn
DEFAULT_COMPANY_ID=holding

# =============================================================================
# Cổng host (máy local / VPS) — khối 280xx mặc định để tránh trùng 3000, 8080, 5173
# (xem PORTS.md). Nếu bị chiếm: chạy `pnpm run deploy:pick-ports` rồi dán đoạn in ra vào đây.
# Tên biến = tên thư mục phân hệ trong repo deploy này (portal-fe, hrm-fe, …).
# =============================================================================
PORTAL_FE_PORT=28088
HRM_FE_PORT=28080
XBOS_FE_PORT=28073
HRM_BE_PORT=28001
XBOS_BE_PORT=28002

# --- Tương thích ngược (compose không đọc các biến cũ; chỉ để migrate tay / tài liệu cũ) ---
# WEB_PORTAL_PORT=8088
# HRM_WEB_PORT=8080
# XBOS_CORE_PORT=5173
# HRM_API_PORT=3001
# XBOS_API_PORT=3002

# Tuỳ chọn — khi chạy portal-fe / hrm-fe trong Docker Compose, compose đã set proxy tới sibling services.
# VITE_DEV_PROXY_HRM_WEB=http://127.0.0.1:28080
# VITE_DEV_PROXY_HRM_API=http://127.0.0.1:28001
# VITE_DEV_PROXY_XBOS_API=http://127.0.0.1:28002

HRM_RATE_LIMIT_WINDOW_MS=60000
HRM_RATE_LIMIT_MAX=600
