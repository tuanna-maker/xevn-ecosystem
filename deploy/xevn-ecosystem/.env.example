# Stack dev / POC (demo khách): dùng **một** mật khẩu Postgres cho user `DB_USER` — không cần secret production tách riêng.
# `XEVN_POC_DEV=1`: script migrate không chặn giá trị mẫu `replace_me` (vẫn phải trùng mật khẩu thực tế trên DB nếu không phải replace_me).
# Hoặc đặt biến máy: XEVN_DB_PASSWORD (PowerShell: $env:XEVN_DB_PASSWORD='...') — không commit.
XEVN_POC_DEV=1

# --- HRM / XBOS: PostgreSQL (chuẩn) — hrm-api → xevn_hrm, xbos-api → xevn_xbos ---
# Web HRM: VITE_HRM_API_ORIGIN=http://127.0.0.1:${HRM_BE_PORT} (không bắt buộc Supabase)

# [LEGACY — chỉ nếu còn nhánh hrm-admin/auth cũ chưa gỡ; có thể để trống]
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev PostgreSQL (cùng cluster; mỗi phân hệ một database logic).
# Tên DB cố định trong script migrate: HRM → xevn_hrm, XBOS → xevn_xbos (xem migrations/README.md).
DB_NAME_HRM=xevn_hrm
DB_NAME_XBOS=xevn_xbos
DB_HOST=113.20.107.184
DB_PORT=6432
DB_USER=app1
# Postgres dev/POC — đặt trùng mật khẩu user trên server dev (một credential dùng chung).
# Nếu DB của bạn đúng literal "replace_me" và đã bật XEVN_POC_DEV=1, migrate sẽ không chặn trước khi kết nối.
DB_PASSWORD="5^S0CEpvYwC1(#YN1UoJ"

# Optional. Leave empty to use DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
DATABASE_URL_HRM=
DATABASE_URL_XBOS=

INTERNAL_API_KEY=xevn-dev-internal-key
# UC-CC-P0-02 — legal document upload storage (Docker bind mount path; local dev uses package default)
# XBOS_LEGAL_DOC_STORAGE_ROOT=/app/apps/api/xbos-api/storage/legal-documents
# VPS :8088 — public origin for file_url in DB (stream GET works without this)
# XBOS_PUBLIC_BASE_URL=http://14.225.217.232:8088
# S2S hrm-be ↔ xbos-be (catalog-governance/workflows/start, config-sync) — must match on both containers
SERVICE_JWT_SECRET=xevn-dev-jwt-secret
SERVICE_JWT_ISSUER=xevn-internal
SERVICE_JWT_AUDIENCE=xevn-api
MASTER_TENANT_ID=xevn
DEFAULT_COMPANY_ID=holding

# =============================================================================
# Cổng host — VPS dev (14.225.217.232) dùng bộ cố định dưới đây (khớp vps-host-ports.defaults).
# Máy local bị trùng cổng: chạy `pnpm run deploy:pick-ports` → dán block in ra (khối 280xx).
# Deploy VPS: không ghi đè cổng đã có trong .env trên server (script merge-vps-port-env.mjs).
# =============================================================================
PORTAL_FE_PORT=8088
HRM_FE_PORT=8080
XBOS_FE_PORT=5173
HRM_BE_PORT=3001
XBOS_BE_PORT=3002

# --- Tương thích tên biến cũ (bootstrap map sang PORTAL_FE_PORT, …) ---
# WEB_PORTAL_PORT=8088
# HRM_WEB_PORT=8080
# XBOS_CORE_PORT=5173
# HRM_API_PORT=3001
# XBOS_API_PORT=3002

# Tuỳ chọn — khi chạy portal-fe / hrm-fe trong Docker Compose, compose đã set proxy tới sibling services.
# VITE_DEV_PROXY_HRM_WEB=http://127.0.0.1:28080
# VITE_DEV_PROXY_HRM_API=http://127.0.0.1:28001
# VITE_DEV_PROXY_XBOS_API=http://127.0.0.1:28002

# UAT concurrent browser QA (menu wave) — 600/min caused RATE-429 on :8088; keep ≥5000
HRM_RATE_LIMIT_WINDOW_MS=60000
HRM_RATE_LIMIT_MAX=10000
XBOS_RATE_LIMIT_WINDOW_MS=60000
XBOS_RATE_LIMIT_MAX=10000

# --- NFR P0/P1 (observability & security) ---
# Production: set NODE_ENV=production, strong SERVICE_JWT_SECRET, CORS_ALLOWED_ORIGINS
SERVICE_JWT_SECRET=xevn-dev-jwt-secret
# Portal login TTL (seconds). Probe P-CC-01-jwt expects 86400 (24h).
PORTAL_LOGIN_JWT_TTL_SEC=86400
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://127.0.0.1:5175
LOG_LEVEL=info
# Prometheus metrics: GET /api/hrm/metrics?format=prometheus
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:31041/v1/traces
# OTEL_TRACE_SAMPLE_RATIO=0.1
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# Dev8088 / ADR scale: raise pool under concurrency (default code=10). Cap so
# hrm+xbos+other apps stay well below Postgres max_connections (probe: 500).
# PG_POOL_MAX=40
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_KEEPALIVE=true
# PG_KEEPALIVE_DELAY_MS=10000

# BULLMQ_ENABLED=false
# PLATFORM_RLS_ENABLED=false

# --- Mock→API dev seed (repo root) — XBOS 28002, HRM 28001 ---
# 1) pnpm seed:stack:p0   (migrate + org + RACI + employees; HRM catalog cần hrm-api)
# 2) pnpm seed:workflow:inbox   (cần xbos-api)
# 3) pnpm seed:business-master:kpi && pnpm seed:business-master:settings-md
# 4) pnpm seed:hrm:operations-sample && pnpm seed:kpi:actuals
# 5) pnpm verify:dev-stack
