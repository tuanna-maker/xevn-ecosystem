# Mật khẩu DB không đưa vào git. Cách dùng:
# - Lần đầu chạy migrate: script tự tạo deploy/dev-server/.env từ file này; điền DB_PASSWORD trong .env đó, hoặc
# - Đặt biến môi trường máy XEVN_DB_PASSWORD (PowerShell session: $env:XEVN_DB_PASSWORD='...').

# --- Supabase (gom chung cho API + web; project ref từ apps/web/hrm/supabase/config.toml) ---
SUPABASE_PROJECT_REF=hbwyuqsjiywtvvellfmn

# Mặc định: Supabase CLI local (`supabase start`) — URL + JWT demo chính thức (anon giống apps/web/hrm/src/integrations/supabase/client.ts).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Khi dùng Supabase Cloud: comment 3 dòng trên, bật 3 dòng dưới và điền anon + service_role từ Dashboard (Settings → API).
# SUPABASE_URL=https://hbwyuqsjiywtvvellfmn.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Web HRM (Vite) — copy sang apps/web/hrm/.env.local hoặc để trùng khi dev local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Dev PostgreSQL (cùng cluster; mỗi phân hệ một database logic).
# Tên DB cố định trong script migrate: HRM → xevn_hrm, XBOS → xevn_xbos (xem migrations/README.md).
DB_HOST=113.20.107.184
DB_PORT=6432
DB_USER=app1
# Nếu mật khẩu có ký tự # hoặc khoảng trắng, bọc trong ngoặc kép: DB_PASSWORD="..."
DB_PASSWORD=replace_me

# Optional. Leave empty to use DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
DATABASE_URL_HRM=
DATABASE_URL_XBOS=

INTERNAL_API_KEY=xevn-dev-internal-key
# Tenant master hiện tại (một tenant); sau này nhiều tenant — runtime vẫn theo x-tenant-id / JWT.
MASTER_TENANT_ID=xevn
# Alias tùy chọn; dùng cho catalog DDL bootstrap cùng MASTER_TENANT_ID.
# DEFAULT_TENANT_ID=
# Mã công ty mặc định cho DDL catalog sync (không thay x-company-id trên request).
DEFAULT_COMPANY_ID=holding

XBOS_API_PORT=3002
HRM_API_PORT=3001
WEB_PORTAL_PORT=8088

HRM_RATE_LIMIT_WINDOW_MS=60000
HRM_RATE_LIMIT_MAX=600
