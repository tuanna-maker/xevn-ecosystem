{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "XeVN: Telegram channel (auto on folder open)",
      "type": "shell",
      "command": "node .cursor/team/telegram-pm/ensure-channel.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
